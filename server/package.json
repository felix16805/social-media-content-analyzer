{
    "name": "smca-backend",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "tsc && npx prisma generate",
        "start": "node dist/index.js",
        "lint": "tsc --noEmit",
        "test": "jest --forceExit --detectOpenHandles",
