        "prisma:deploy": "prisma migrate deploy",
        "prisma:studio": "prisma studio"
    },
    "dependencies": {
        "@prisma/client": "^6.9.0",
        "cors": "^2.8.5",
        "express": "^5.1.0",
        "express-rate-limit": "^8.6.2",
        "helmet": "^8.3.0",
        "pino": "^10.3.1",
        "pino-pretty": "^13.0.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@types/cors": "^2.8.17",
        "@types/express": "^5.0.0",
        "@types/jest": "^29.5.14",
        "@types/node": "^22.10.2",
        "@types/supertest": "^7.2.1",
        "jest": "^29.7.0",
        "prisma": "^6.9.0",
        "supertest": "^7.2.2",
        "ts-jest": "^29.3.0",
        "tsx": "^4.19.2",
        "typescript": "^5.9.3"
    }
