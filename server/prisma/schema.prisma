generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Analysis {
  id               String   @id @default(uuid())
  createdAt        DateTime @default(now())
  extractedText    String
  wordCount        Int
  sentenceCount    Int
  hashtagCount     Int
  emojiCount       Int
  hasCallToAction  Boolean
  readabilityScore Int      // avgWordsPerSentence
  overallScore     Int
  suggestions      Json     // Suggestion[] stored as JSON
  platforms        Json     // Record<Platform, PlatformAssessment>
}
